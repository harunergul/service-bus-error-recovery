# Setting ACCEPT_EULA=Y accepts the Service Bus emulator and SQL Server license terms:
# https://github.com/Azure/azure-service-bus-emulator-installer/blob/main/EMULATOR_EULA.txt
ACCEPT_EULA=Y
# Local-only password for the emulator's SQL Server (must meet SQL Server complexity rules)
MSSQL_SA_PASSWORD=LocalOnly_Passw0rd!
